rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Get user document
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper to check for admin role
    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'admin' ||
        request.auth.token.email.lower() == 'yassinegr44@gmail.com'
      );
    }

    // Helper to check for staff role (includes admin and legacy agent)
    function isStaff() {
      return isAuthenticated() && (
        getUserData().role == 'staff' || 
        getUserData().role == 'admin' || 
        getUserData().role == 'agent'
      );
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (request.auth.uid == userId && 
         (
           request.auth.token.email.lower() == 'yassinegr44@gmail.com' || 
           (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'email'])) ||
           (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']) && resource.data.role == 'agent' && request.resource.data.role == 'staff')
         )
        )
      );
      allow delete: if isAdmin();
    }

    // Core application data
    match /deceased/{recordId} {
      allow read, write: if isStaff();
    }

    match /historical_deceased/{recordId} {
      allow read, write: if isStaff();
    }

    match /amputees/{recordId} {
      allow read, write: if isStaff();
    }

    match /fridge/{positionId} {
      allow read, write: if isStaff();
    }

    match /settings/{settingId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
  }
}
